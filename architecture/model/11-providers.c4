      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/ovhcloud.py' public_module 'pydantic_ai.providers.ovhcloud.OVHcloudProvider' }
    }
    c_sambanova_api = service 'SambaNova API' {
      description 'SambaNova inference endpoint exposed through an OpenAI-compatible API.'
      link https://github.com/pydantic/pydantic-ai/blob/001ed141fd1057d0035557353f87559eced5b0a7/pydantic_ai_slim/pydantic_ai/providers/sambanova.py 'Provider configuration'
      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/sambanova.py' public_module 'pydantic_ai.providers.sambanova.SambaNovaProvider' }
    }
    c_snowflake_api = service 'Snowflake Cortex AI' {
      description 'Snowflake-hosted model endpoint configured through the OpenAI-compatible provider.'
      link https://github.com/pydantic/pydantic-ai/blob/001ed141fd1057d0035557353f87559eced5b0a7/pydantic_ai_slim/pydantic_ai/providers/snowflake.py 'Provider configuration'
      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/snowflake.py' public_module 'pydantic_ai.providers.snowflake.SnowflakeProvider' }
    }
    c_together_api = service 'Together AI API' {
      description 'Together inference endpoint selected through the OpenAI-compatible provider.'
      link https://github.com/pydantic/pydantic-ai/blob/001ed141fd1057d0035557353f87559eced5b0a7/pydantic_ai_slim/pydantic_ai/providers/together.py 'Provider configuration'
      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/together.py' public_module 'pydantic_ai.providers.together.TogetherProvider' }
    }
    c_vercel_ai_gateway = service 'Vercel AI Gateway' {
      description 'Vercel AI Gateway endpoint configured through the OpenAI-compatible provider.'
      link https://github.com/pydantic/pydantic-ai/blob/001ed141fd1057d0035557353f87559eced5b0a7/pydantic_ai_slim/pydantic_ai/providers/vercel.py 'Provider configuration'
      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/vercel.py' public_module 'pydantic_ai.providers.vercel.VercelProvider' }
    }
    c_vllm_api = service 'vLLM server' {
      description 'A local or remote vLLM server exposing the OpenAI-compatible API.'
      link https://github.com/pydantic/pydantic-ai/blob/001ed141fd1057d0035557353f87559eced5b0a7/pydantic_ai_slim/pydantic_ai/providers/vllm.py 'Provider configuration'
      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/vllm.py' public_module 'pydantic_ai.providers.vllm.VLLMProvider' }
    }
    c_zai_api = service 'Z.AI API' {
      description 'Z.AI model endpoint selected through its OpenAI-compatible provider.'
      link https://github.com/pydantic/pydantic-ai/blob/001ed141fd1057d0035557353f87559eced5b0a7/pydantic_ai_slim/pydantic_ai/providers/zai.py 'Provider configuration'
      metadata { source_path 'pydantic_ai_slim/pydantic_ai/providers/zai.py' public_module 'pydantic_ai.providers.zai.ZaiProvider' }
    }
  }

  repo.slim.providers -[depends_on]-> externals.c_openai_sdk 'OpenAI and OpenAI-compatible client'
  repo.slim.models -[depends_on]-> externals.c_openai_sdk 'OpenAI chat, responses, embeddings, and realtime adapters'
  repo.slim.providers -[depends_on]-> externals.c_anthropic_sdk 'Anthropic client'
  repo.slim.providers -[depends_on]-> externals.c_boto_sdk 'Bedrock Runtime client'
  repo.slim.providers -[depends_on]-> externals.c_cohere_sdk 'Cohere client'
  repo.slim.providers -[depends_on]-> externals.c_google_genai_sdk 'Gemini and Vertex client'
  repo.slim.providers -[depends_on]-> externals.c_groq_sdk 'Groq client'
  repo.slim.providers -[depends_on]-> externals.c_huggingface_sdk 'Hugging Face inference client'
  repo.slim.providers -[depends_on]-> externals.c_mistral_sdk 'Mistral client'
  repo.slim.providers -[depends_on]-> externals.c_typesafe_sdk 'TypeSafe client'
  repo.slim.providers -[depends_on]-> externals.c_voyageai_sdk 'Voyage AI client'
  repo.slim.providers -[depends_on]-> externals.c_xai_sdk 'xAI client'
  repo.slim.providers -[depends_on]-> externals.c_sentence_transformers 'local embedding implementation'
  repo.slim.providers -[depends_on]-> externals.c_httpx2 'provider-specific HTTP and OAuth requests'
  repo.slim.mcp -[depends_on]-> externals.c_fastmcp_sdk 'MCP client and transports'

  externals.c_anthropic_sdk -[network]-> externals.c_anthropic_api 'Anthropic API requests'
  externals.c_anthropic_sdk -[network]-> externals.c_bedrock_runtime_api 'when Anthropic models are routed through Bedrock'
  externals.c_boto_sdk -[network]-> externals.c_bedrock_runtime_api 'Bedrock Runtime requests'
  externals.c_openai_sdk -[network]-> externals.c_bedrock_mantle_api 'configured Bedrock Mantle endpoint'
  externals.c_cohere_sdk -[network]-> externals.c_cohere_api 'Cohere API requests'
  externals.c_google_genai_sdk -[network]-> externals.c_gemini_api 'Gemini API requests'
  externals.c_google_genai_sdk -[network]-> externals.c_vertex_ai 'Vertex AI requests'
  externals.c_groq_sdk -[network]-> externals.c_groq_api 'Groq API requests'
  externals.c_huggingface_sdk -[network]-> externals.c_huggingface_inference 'configured inference requests'
  externals.c_mistral_sdk -[network]-> externals.c_mistral_api 'Mistral API requests'
  externals.c_typesafe_sdk -[network]-> externals.c_typesafe_api 'TypeSafe API requests'
  externals.c_voyageai_sdk -[network]-> externals.c_voyageai_api 'Voyage AI API requests'
  externals.c_xai_sdk -[network]-> externals.c_xai_api 'xAI API requests'
  externals.c_httpx2 -[network]-> externals.c_system_one_api 'configured System One requests'
  externals.c_httpx2 -[network]-> externals.c_pydantic_gateway 'configured gateway route'
  externals.c_httpx2 -[network]-> externals.c_openai_oauth 'Codex authorization and token refresh'
  externals.c_httpx2 -[network]-> externals.c_github_oauth 'Copilot device authorization and token requests'
  externals.c_openai_sdk -[network]-> externals.c_openai_codex_api 'Codex model requests'
  externals.c_temporal_sdk -[network]-> externals.temporal_service 'when TemporalDurability is configured'
  externals.c_dbos_sdk -[reads_writes]-> externals.dbos_database 'when DBOSDurability is configured'
  externals.c_prefect_sdk -[network]-> externals.prefect_service 'when PrefectDurability is configured'
  externals.c_fastmcp_sdk -[network]-> externals.mcp_http 'when HTTP transport is configured'
  externals.c_fastmcp_sdk -[executes]-> externals.mcp_stdio 'when stdio transport is configured'
  externals.c_fastmcp_sdk -[calls]-> externals.mcp_inprocess 'when an in-process server is configured'

  externals.c_openai_sdk -[network]-> externals.c_alibaba_dashscope 'configured DashScope requests'
  externals.c_openai_sdk -[network]-> externals.c_azure_openai 'configured Azure requests'
  externals.c_openai_sdk -[network]-> externals.c_cerebras_api 'configured Cerebras requests'
  externals.c_openai_sdk -[network]-> externals.c_crusoe_api 'configured Crusoe requests'
  externals.c_openai_sdk -[network]-> externals.c_deepseek_api 'configured DeepSeek requests'
  externals.c_openai_sdk -[network]-> externals.c_fireworks_api 'configured Fireworks requests'
  externals.c_openai_sdk -[network]-> externals.c_github_copilot_api 'configured Copilot requests'
  externals.c_openai_sdk -[network]-> externals.c_heroku_api 'configured Heroku requests'
  externals.c_openai_sdk -[network]-> externals.c_litellm_proxy 'configured proxy requests'
  externals.c_openai_sdk -[network]-> externals.c_moonshotai_api 'configured Moonshot requests'
  externals.c_openai_sdk -[network]-> externals.c_nebius_api 'configured Nebius requests'
  externals.c_openai_sdk -[network]-> externals.c_ollama_api 'configured local or remote Ollama requests'
  externals.c_openai_sdk -[network]-> externals.c_openai_api 'OpenAI API requests'
  externals.c_openai_sdk -[network]-> externals.c_openrouter_api 'configured OpenRouter requests'
  externals.c_openai_sdk -[network]-> externals.c_ovhcloud_api 'configured OVHcloud requests'
  externals.c_openai_sdk -[network]-> externals.c_sambanova_api 'configured SambaNova requests'
  externals.c_openai_sdk -[network]-> externals.c_snowflake_api 'configured Snowflake requests'
  externals.c_openai_sdk -[network]-> externals.c_together_api 'configured Together requests'
  externals.c_openai_sdk -[network]-> externals.c_vercel_ai_gateway 'configured Vercel gateway requests'
  externals.c_openai_sdk -[network]-> externals.c_vllm_api 'configured local or remote vLLM requests'
  externals.c_openai_sdk -[network]-> externals.c_zai_api 'configured Z.AI requests'

  repo.slim.embeddings -[network]-> externals.c_cohere_api 'when Cohere embeddings are selected'
  repo.slim.embeddings -[network]-> externals.c_bedrock_runtime_api 'when Bedrock embeddings are selected'
  repo.slim.embeddings -[network]-> externals.c_gemini_api 'when Gemini embeddings are selected'
  repo.slim.embeddings -[network]-> externals.c_openai_api 'when OpenAI embeddings are selected'
  repo.slim.embeddings -[network]-> externals.c_voyageai_api 'when Voyage AI embeddings are selected'
  repo.slim.embeddings -[calls]-> externals.c_sentence_transformers 'when local embeddings are selected'
  repo.slim.realtime -[network]-> externals.c_openai_api 'when OpenAI realtime is selected'
  repo.slim.realtime -[network]-> externals.c_azure_openai 'when Azure realtime is selected'
  repo.slim.realtime -[network]-> externals.c_gemini_api 'when Google realtime is selected'
  repo.slim.realtime -[network]-> externals.c_xai_api 'when xAI realtime is selected'
}

views {
    view provider_request_boundary {
      #interface
      title 'Provider request boundary'
      description 'One example of the request path: core model adapter to a configured provider client and remote API. Provider configuration selects the service and client; interface scenarios are user-selected configurations, not deployments with every integration active.'
      include repo.slim.models, repo.slim.providers, repo.slim.profiles, externals.c_openai_sdk, externals.c_openai_api, externals.c_anthropic_sdk, externals.c_anthropic_api
    }

    view native_provider_integrations {
      #interface
      title 'Native provider integrations'
      description 'Provider families backed by their native SDK or a provider-specific HTTP protocol. Installing a provider extra and choosing its provider are application decisions.'
      include repo.slim.providers, repo.slim.models, externals.c_anthropic_sdk, externals.c_anthropic_api, externals.c_boto_sdk, externals.c_bedrock_runtime_api, externals.c_cohere_sdk, externals.c_cohere_api, externals.c_google_genai_sdk, externals.c_gemini_api, externals.c_vertex_ai, externals.c_groq_sdk, externals.c_groq_api, externals.c_huggingface_sdk, externals.c_huggingface_inference, externals.c_mistral_sdk, externals.c_mistral_api, externals.c_typesafe_sdk, externals.c_typesafe_api, externals.c_voyageai_sdk, externals.c_voyageai_api, externals.c_xai_sdk, externals.c_xai_api, externals.c_system_one_api, externals.c_pydantic_gateway, externals.c_openai_codex_api, externals.c_openai_oauth, externals.c_github_oauth
    }

    view openai_compatible_integrations {
      #interface
      title 'OpenAI-compatible endpoints'
      description 'These endpoint families share the OpenAI Python client contract, while each provider configures its own base URL, authentication, and model profile. The OpenAI SDK is a client dependency, not the remote service.'
      include repo.slim.providers, repo.slim.models, externals.c_openai_sdk, externals.c_alibaba_dashscope, externals.c_azure_openai, externals.c_bedrock_mantle_api, externals.c_cerebras_api, externals.c_crusoe_api, externals.c_deepseek_api, externals.c_fireworks_api, externals.c_github_copilot_api, externals.c_heroku_api, externals.c_litellm_proxy, externals.c_moonshotai_api, externals.c_nebius_api, externals.c_ollama_api, externals.c_openai_api, externals.c_openrouter_api, externals.c_ovhcloud_api, externals.c_sambanova_api, externals.c_snowflake_api, externals.c_together_api, externals.c_vercel_ai_gateway, externals.c_vllm_api, externals.c_zai_api
    }

    view embedding_integrations {
      #interface
      title 'Embedding integrations'
      description 'The embedding interface supports optional remote provider APIs and a local Sentence Transformers implementation; applications select and install only the backend they need.'
      include repo.slim.embeddings, externals.c_openai_sdk, externals.c_openai_api, externals.c_cohere_sdk, externals.c_cohere_api, externals.c_google_genai_sdk, externals.c_gemini_api, externals.c_boto_sdk, externals.c_bedrock_runtime_api, externals.c_voyageai_sdk, externals.c_voyageai_api, externals.c_sentence_transformers
    }

    view realtime_integrations {
      #interface
      title 'Realtime integrations'
      description 'Realtime sessions are opt-in adapters for selected provider protocols. OpenAI, Azure, Google, and xAI paths are configurable and are not requirements for ordinary Agent runs.'
      include repo.slim.realtime, externals.c_openai_sdk, externals.c_openai_api, externals.c_azure_openai, externals.c_google_genai_sdk, externals.c_gemini_api, externals.c_xai_sdk, externals.c_xai_api
    }
}
