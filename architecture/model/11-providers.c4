model {
  extend externals {
    c_openai_sdk = library 'OpenAI Python SDK' {
      description 'Client library used by OpenAI and the OpenAI-compatible provider adapters. A compatible endpoint is selected through provider configuration; use does not imply an OpenAI account.'
